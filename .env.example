# ============================================================
# LLM 配置（OpenAI 或兼容服务，如 DeepSeek、智谱等）
# ============================================================
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Embeddings 配置（可选，不设置则回退到 LLM 配置）
# 支持腾讯混元、OpenAI 等兼容 /embeddings 接口的服务
# ============================================================
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# EMBEDDING_API_KEY=sk-your-embedding-key-here
# EMBEDDING_MODEL=hunyuan-embedding
# EMBEDDING_DIMENSION=1024

# ============================================================
# Milvus 向量数据库（可选，默认使用本地文件模式 Milvus Lite）
# ============================================================
# MILVUS_URI=./milvus_lite.db
# MILVUS_TOKEN=
